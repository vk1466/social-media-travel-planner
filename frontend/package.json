    "prebuild": "node -e \"const fs=require('fs'); fs.mkdirSync('public/assets', {recursive:true}); fs.copyFileSync('node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs', 'public/assets/maplibre-gl-worker.mjs');\"",
    "dev": "vite",

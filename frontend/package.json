    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource/instrument-serif": "^5.2.8",
    "@types/supercluster": "^7.1.3",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.16.0",
    "open-props": "^1.7.23",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1",
    "simple-icons": "^16.30.0",

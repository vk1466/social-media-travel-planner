{
  "headers": [
    {
      "source": "/assets/(.*\\.mjs)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://tb5bi7r4sjpvsfxdulnpolhx2u0aswhk.lambda-url.us-west-2.on.aws/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://tb5bi7r4sjpvsfxdulnpolhx2u0aswhk.lambda-url.us-west-2.on.aws/api/$1"
    },
    {
      "source": "/((?!api(?:/|$)|assets(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}

# Link ingestion APIs (used by CLI / Lambda; set via CDK deploy for AWS)
ENSEMBLEDATA_TOKEN=
SUPADATA_API_KEY=

# Place geocoding uses Nominatim (OpenStreetMap) via geopy — no API key needed.

# Optional: Google Geocoding / Places Text Search fallback when Nominatim fails (1f).
# Keep unset to avoid spend; enable FeatureFlag.google_geocode_fallback when ready.
# GOOGLE_MAPS_API_KEY=

# Optional: US National Park Service (place facts Phase 4)
# NPS_API_KEY=

# OpenAI — caption extraction, hierarchy naming, and locate candidate picker (1g)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# App logs (CLI + Lambda → CloudWatch). DEBUG includes locate queries/notes.
# LOG_LEVEL=INFO

# Instagram profile → Visited import: how many latest posts to pull (default 5)
# INSTAGRAM_PROFILE_POST_LIMIT=5

# Google Maps Timeline upload (async SFN job)
# TIMELINE_BATCH_SIZE=100
# TIMELINE_HOME_EXCLUDE_KM=30
# TIMELINE_MAX_PLACES_PER_CALL=100
# Travel-significance filter: what counts as a trip, and when a place is routine
# TIMELINE_DAY_TRIP_MIN_KM=150
# TIMELINE_MIN_TRIP_DAYS=2
# TIMELINE_ROUTINE_VISIT_COUNT=5
# TIMELINE_IMPORTS_BUCKET=  # set by CDK
# TIMELINE_STATE_MACHINE_ARN=  # set by CDK

# CLI against TravelPlanner-dev (uses your AWS credentials / default profile)
# DYNAMODB_REGION=us-west-2
# DYNAMODB_STAGE=dev

# Optional: restrict admin routes when running tools against AWS
# ADMIN_USER_IDS=user_xxx,user_yyy
